# ============================================
# Video BA Pipe - RK3588 (Debian + NPU)
# 适用于RK3588 arm64 Debian + NPU运行时
# ============================================

ARG FFMPEG_RK_IMAGE=video-ba-pipe-ffmpeg-rk:rkmpp
FROM ${FFMPEG_RK_IMAGE} AS ffmpeg_rk

# 明确 arm64 架构；RKNNLite 2.3.2 wheel 与 Python 3.11 ABI 匹配。
FROM --platform=linux/arm64 arm64v8/python:3.11-slim-bookworm

# 由镜像构建流程根据最近 Git 提交注入。
ARG APP_VERSION=unknown
ARG BUILD_TIME=unknown

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    TZ=Asia/Shanghai \
    APP_VERSION=${APP_VERSION} \
    BUILD_TIME=${BUILD_TIME}

# 设置工作目录
WORKDIR /app

# 安装系统依赖（仅运行时所需）
RUN set -eux; \
    apt-get -o Acquire::Retries=3 update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      fonts-wqy-zenhei \
      libglib2.0-0 \
      libsm6 \
      libxext6 \
      libxrender1 \
      libgomp1 \
      libgl1 \
      postgresql-client; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

COPY --from=ffmpeg_rk /opt/ffmpeg /opt/ffmpeg

# 固定使用 Rockchip 官方 v2.3.2 runtime。RKNNLite 会直接加载
# /usr/lib/librknnrt.so，因此必须在镜像内提供这个精确路径。
ADD --checksum=sha256:d31fc19c85b85f6091b2bd0f6af9d962d5264a4e410bfb536402ec92bac738e8 \
    https://raw.githubusercontent.com/airockchip/rknn-toolkit2/v2.3.2/rknpu2/runtime/Linux/librknn_api/aarch64/librknnrt.so \
    /usr/lib/librknnrt.so

RUN set -eux; \
    chmod 0644 /usr/lib/librknnrt.so; \
    ldd /usr/lib/librknnrt.so; \
    ! ldd /usr/lib/librknnrt.so | grep -q 'not found'

RUN set -eux; \
    export PATH="/opt/ffmpeg/bin:${PATH}"; \
    export LD_LIBRARY_PATH="/opt/ffmpeg/lib:/opt/ffmpeg/lib64:/usr/local/lib:/usr/lib/aarch64-linux-gnu"; \
    /opt/ffmpeg/bin/ffmpeg -version; \
    /opt/ffmpeg/bin/ffprobe -version

# 升级 pip
RUN python -m pip install --upgrade pip setuptools wheel

# 可选：预装 PyTorch（如需使用 ultralytics）
# 通过 --build-arg TORCH_WHL=URL_OR_PATH 指定
ARG TORCH_WHL=""
RUN if [ -n "$TORCH_WHL" ]; then pip install "$TORCH_WHL"; fi

# 可选：预装 aarch64 版 onnxruntime wheel
# 通过 --build-arg ONNXRUNTIME_WHL=URL_OR_PATH 指定
ARG ONNXRUNTIME_WHL=""
RUN if [ -n "$ONNXRUNTIME_WHL" ]; then pip install "$ONNXRUNTIME_WHL"; fi

# 复制依赖文件
COPY requirements.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements.txt

# 固定安装与 librknnrt.so 匹配的 Rockchip 官方 v2.3.2 CPython 3.11 ARM64 wheel。
# checksum 可避免下载内容或上游 tag 被意外替换。
ADD --checksum=sha256:bda74f1179e15fccb8726054a24898982522784b65bb340b20146955d254e800 \
    https://raw.githubusercontent.com/airockchip/rknn-toolkit2/v2.3.2/rknn-toolkit-lite2/packages/rknn_toolkit_lite2-2.3.2-cp311-cp311-manylinux_2_17_aarch64.manylinux2014_aarch64.whl \
    /tmp/rknn_toolkit_lite2-2.3.2-cp311-cp311-manylinux_2_17_aarch64.manylinux2014_aarch64.whl

RUN set -eux; \
    pip install /tmp/rknn_toolkit_lite2-2.3.2-cp311-cp311-manylinux_2_17_aarch64.manylinux2014_aarch64.whl; \
    python -c "import importlib.metadata as m; assert m.version('rknn-toolkit-lite2') == '2.3.2'"; \
    rm -f /tmp/rknn_toolkit_lite2-2.3.2-cp311-cp311-manylinux_2_17_aarch64.manylinux2014_aarch64.whl

# 复制应用代码
COPY app/ /app/app/
COPY scripts/ /app/scripts/
COPY docs/openapi.yaml docs/openapi_usage.md /app/docs/
COPY env.example /app/.env.example

# 创建必要的数据目录
RUN mkdir -p /data/db \
    /data/frames \
    /data/videos \
    /data/models \
    /data/snapshots \
    /data/logs \
    /data/user_scripts

RUN chmod +x /app/app/entrypoint.sh

# FFmpeg 运行库路径；RKNN runtime 已内置在 /usr/lib/librknnrt.so。
ENV PATH="/opt/ffmpeg/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/ffmpeg/lib:/opt/ffmpeg/lib64:/usr/local/lib:/usr/lib/aarch64-linux-gnu:${LD_LIBRARY_PATH}"
VOLUME ["/data"]

# 暴露端口
EXPOSE 5000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

WORKDIR /app/app
ENV PYTHONPATH="/app:$PYTHONPATH"

# 设置入口点
ENTRYPOINT ["./entrypoint.sh"]

# 标签信息
LABEL maintainer="Codvision" \
      version="${APP_VERSION}" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      description="Video Behavior Analysis Pipeline - RK3588 NPU Version" \
      npu.enabled="true"
