# ============================================
# Video BA Pipe - X86 + CUDA/GPU 版本
# 适用于 X86 服务器 + NVIDIA GPU 的生产环境
# 配套编排模板: deploy/compose/templates/cuda.yml（通过生成器产出 docker-compose.yml）
# 内置 NVDEC 硬解预算(NVML 利用率闸门 + GPU 型号查表,
# 依赖 requirements.txt 中的 pynvml)
# ============================================

# 使用官方NVIDIA CUDA基础镜像
# CUDA 11.8 + cuDNN 8 + Ubuntu 22.04
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04 AS runtime-base

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# 设置工作目录
WORKDIR /app

# 安装系统依赖。Acquire::Retries 应对 archive.ubuntu.com 偶发 Connection reset。
RUN set -eux; \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
    echo 'Acquire::http::Pipeline-Depth "0";' >> /etc/apt/apt.conf.d/80-retries; \
    i=0; \
    until apt-get update && apt-get install -y --no-install-recommends --fix-missing \
        python3.10 \
        python3-pip \
        python3-dev \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
        libgl1-mesa-glx \
        zlib1g \
        fonts-wqy-zenhei \
        ffmpeg \
        libavcodec-dev \
        libavformat-dev \
        libswscale-dev \
        wget \
        curl \
        xz-utils \
        git \
        postgresql-client \
        tzdata; do \
      i=$((i + 1)); \
      [ "$i" -lt 5 ]; \
      echo "apt-get failed, retry ${i}/5 in 5s"; \
      sleep 5; \
    done; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# ============================================
# 安装带 cuvid/NVDEC 的 ffmpeg (BtbN 静态构建)
# 说明: stock Ubuntu apt 版 ffmpeg 未编译 --enable-cuvid/--enable-nvdec,
# 导致 NVDEC 解码器(app/core/decoder/nv.py 里的 h264_cuvid)启动即报
# "Unknown decoder 'h264_cuvid'" 退出码1 → orchestrator 分类为 clean 循环重启。
# BtbN 的 linux64-gpl 构建通过 ffnvcodec 头编译了 cuvid/nvdec/nvenc,
# 运行时由 NVIDIA Container Runtime 的 `video` 能力注入的 libnvcuvid.so 提供。
# 安装到 /usr/local/bin 以覆盖 apt 版 ffmpeg(ffprobe 一并替换)。
# 如需可复现构建/供应链校验:把 ARG 固定到某个版本 tag,并加 --fail sha256 校验。
# 下方的 grep 检查是硬保证——若 cuvid 缺失,镜像构建会立即失败而非静默产出坏镜像。
# 下载用 curl 重试(--retry-all-errors):BtbN 的 latest 发布后偶有 CDN 5xx/中断,
# 无重试时一次瞬时抖动就会否决整次镜像构建。
# ============================================
ARG FFMPEG_CUVID_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz
RUN set -eux; \
    curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --retry-connrefused "${FFMPEG_CUVID_URL}" -o /tmp/ffmpeg.tar.xz; \
    test -s /tmp/ffmpeg.tar.xz; \
    xz --test /tmp/ffmpeg.tar.xz; \
    mkdir -p /tmp/ffmpeg-extract; \
    tar -xJf /tmp/ffmpeg.tar.xz --strip-components=1 -C /tmp/ffmpeg-extract; \
    test -x /tmp/ffmpeg-extract/bin/ffmpeg; \
    test -x /tmp/ffmpeg-extract/bin/ffprobe; \
    install -m 0755 /tmp/ffmpeg-extract/bin/ffmpeg  /usr/local/bin/ffmpeg; \
    install -m 0755 /tmp/ffmpeg-extract/bin/ffprobe /usr/local/bin/ffprobe; \
    rm -rf /tmp/ffmpeg.tar.xz /tmp/ffmpeg-extract; \
    /usr/local/bin/ffmpeg -hide_banner -decoders > /tmp/ffmpeg-decoders.txt; \
    grep -q 'h264_cuvid' /tmp/ffmpeg-decoders.txt; \
    /usr/local/bin/ffmpeg -hide_banner -hwaccels > /tmp/ffmpeg-hwaccels.txt; \
    grep -qx 'cuda' /tmp/ffmpeg-hwaccels.txt; \
    rm -f /tmp/ffmpeg-decoders.txt /tmp/ffmpeg-hwaccels.txt; \
    /usr/local/bin/ffmpeg -version | sed -n '1p'

# 升级pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# 先安装PyTorch（CUDA版本）
# 使用CUDA 11.8对应的PyTorch版本
# 必须钉版到 2.3.x:cu118 索引上 2.4.0+ 的 wheel 改用 cuDNN 9(libcudnn.so.9),
# 而本镜像基础层 nvidia/cuda:11.8.0-cudnn8 只提供 cuDNN 8(libcudnn.so.8),
# 不钉版会把 torch 拉到最新的 2.5.1(cuDNN 9),import torch 即报
# "libcudnn.so.9: cannot open shared object file"。2.3.1 是最后一个 cuDNN 8 的
# cu118 release,与基础层、paddlepaddle-gpu(cuDNN 8) 三者一致。
# 注意:requirements.worker.txt 里的 ultralytics 声明的是 torch>=1.8(下限),
# 后续依赖安装不会把 torch 顶回 2.5.x,钉版安全。
RUN pip3 install torch==2.3.1 torchvision==0.18.1 torchaudio==2.3.1 --index-url https://download.pytorch.org/whl/cu118

# 复制依赖文件
COPY requirements.control.txt requirements.worker.txt ./
COPY requirements.ocr.txt .

# 安装Python依赖
RUN pip3 install --no-cache-dir -r requirements.worker.txt

# 通用 worker 依赖安装 CPU 版 ONNX Runtime。CUDA 镜像必须将其
# 替换为 CUDA 11.8 + cuDNN 8 构建，否则人脸 ONNX 模型只会暴露
# CPUExecutionProvider。1.20.1 与本镜像的 PyTorch 2.3.1/cu118/cuDNN 8
# 组合一致；CUDA 11 wheel 使用 ONNX Runtime 官方 Azure feed 发布。
ARG ONNXRUNTIME_GPU_VERSION=1.20.1
ARG ONNXRUNTIME_CUDA11_INDEX=https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/onnxruntime-cuda-11/pypi/simple/
RUN pip3 uninstall -y onnxruntime \
    && pip3 install --no-cache-dir --no-deps \
      "onnxruntime-gpu==${ONNXRUNTIME_GPU_VERSION}" \
      --index-url "${ONNXRUNTIME_CUDA11_INDEX}" \
    && python3 -c "import onnxruntime as ort; providers = ort.get_available_providers(); assert 'CUDAExecutionProvider' in providers, providers; print('onnxruntime=' + ort.__version__ + ', providers=' + ','.join(providers))"
RUN pip3 install --no-cache-dir paddlepaddle-gpu==3.0.0 \
      -i https://www.paddlepaddle.org.cn/packages/stable/cu118/ \
    && pip3 install --no-cache-dir -r requirements.ocr.txt

# Build 阶段即验证 PyTorch/cuDNN/Ultralytics 的动态库闭包。这里不要求存在
# NVIDIA 驱动或可见 GPU，只验证 import，避免把 libcudnn.so 版本不匹配的
# 镜像成功推送后才在共享模型子进程中循环超时。
RUN python3 -c "import torch; from ultralytics import YOLO; print('torch=' + torch.__version__ + ', cuda=' + str(torch.version.cuda) + ', ultralytics_import=ok')"

FROM runtime-base AS worker

# 版本参数只影响轻量应用层，避免每次发布让 GB 级依赖层失效。
ARG APP_VERSION=unknown
ARG BUILD_TIME=unknown
ENV APP_VERSION=${APP_VERSION} \
    BUILD_TIME=${BUILD_TIME}

# 复制应用代码
COPY app/ /app/app/
COPY scripts/ /app/scripts/
COPY docs/openapi.yaml docs/openapi_usage.md /app/docs/
COPY env.example /app/.env.example

# 创建必要的数据目录
RUN mkdir -p /data/db \
    /data/frames \
    /data/videos \
    /data/models \
    /data/snapshots \
    /data/logs \
    /data/user_scripts

RUN chmod +x /app/app/entrypoint.sh

# 设置数据卷
VOLUME ["/data"]

# 暴露端口（如果有Web服务）
EXPOSE 5000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import sys; sys.exit(0)" || exit 1

WORKDIR /app/app

ENV TZ=Asia/Shanghai
# 装了 tzdata 后 TZ=Asia/Shanghai 即生效；再软链 /etc/localtime 作双保险
# （运行时会被 compose 只读挂载的宿主机 /etc/localtime 覆盖，但不影响 TZ 解析）。
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
ENV PYTHONPATH=/app

# 设置入口点
ENTRYPOINT ["./entrypoint.sh"]

# 标签信息
LABEL maintainer="Video BA Pipe Team" \
      version="${APP_VERSION}" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      description="Video Behavior Analysis Pipeline - X86 + CUDA/GPU Version" \
      gpu.enabled="true"
