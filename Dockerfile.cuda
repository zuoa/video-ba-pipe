# ============================================
# Video BA Pipe - X86 + CUDA/GPU 版本
# 适用于 X86 服务器 + NVIDIA GPU 的生产环境
# 配套编排文件: docker-compose.yml.x86+cuda
# 内置 NVDEC 硬解预算(NVML 利用率闸门 + GPU 型号查表,
# 依赖 requirements.txt 中的 pynvml)
# ============================================

# 使用官方NVIDIA CUDA基础镜像
# CUDA 11.8 + cuDNN 8 + Ubuntu 22.04
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3-dev \
    # OpenCV依赖
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    # FFmpeg和视频编解码
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    # 其他工具
    wget \
    curl \
    git \
    postgresql-client \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================
# 安装带 cuvid/NVDEC 的 ffmpeg (BtbN 静态构建)
# 说明: stock Ubuntu apt 版 ffmpeg 未编译 --enable-cuvid/--enable-nvdec,
# 导致 NVDEC 解码器(app/core/decoder/nv.py 里的 h264_cuvid)启动即报
# "Unknown decoder 'h264_cuvid'" 退出码1 → orchestrator 分类为 clean 循环重启。
# BtbN 的 linux64-gpl 构建通过 ffnvcodec 头编译了 cuvid/nvdec/nvenc,
# 运行时由 NVIDIA Container Runtime 的 `video` 能力注入的 libnvcuvid.so 提供。
# 安装到 /usr/local/bin 以覆盖 apt 版 ffmpeg(ffprobe 一并替换)。
# 如需可复现构建/供应链校验:把 ARG 固定到某个版本 tag,并加 --fail sha256 校验。
# 下方的 grep 检查是硬保证——若 cuvid 缺失,镜像构建会立即失败而非静默产出坏镜像。
# ============================================
ARG FFMPEG_CUVID_URL=https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz
RUN set -eux; \
    curl -fsSL "${FFMPEG_CUVID_URL}" -o /tmp/ffmpeg.tar.xz; \
    mkdir -p /tmp/ffmpeg-extract; \
    tar -xf /tmp/ffmpeg.tar.xz --strip-components=1 -C /tmp/ffmpeg-extract; \
    install -m 0755 /tmp/ffmpeg-extract/bin/ffmpeg  /usr/local/bin/ffmpeg; \
    install -m 0755 /tmp/ffmpeg-extract/bin/ffprobe /usr/local/bin/ffprobe; \
    rm -rf /tmp/ffmpeg.tar.xz /tmp/ffmpeg-extract; \
    /usr/local/bin/ffmpeg -hide_banner -decoders  | grep -q 'h264_cuvid'; \
    /usr/local/bin/ffmpeg -hide_banner -hwaccels | grep -qw cuda; \
    /usr/local/bin/ffmpeg -version | head -n1

# 升级pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# 先安装PyTorch（CUDA版本）
# 使用CUDA 11.8对应的PyTorch版本
RUN pip3 install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu118

# 复制依赖文件
COPY requirements.txt .
COPY requirements.ocr.txt .

# 安装Python依赖
RUN pip3 install --no-cache-dir -r requirements.txt
RUN pip3 install --no-cache-dir paddlepaddle-gpu==3.0.0 \
      -i https://www.paddlepaddle.org.cn/packages/stable/cu118/ \
    && pip3 install --no-cache-dir -r requirements.ocr.txt

# 复制应用代码
COPY app/ /app/app/
COPY scripts/ /app/scripts/
COPY env.example /app/.env.example

# 创建必要的数据目录
RUN mkdir -p /data/db \
    /data/frames \
    /data/videos \
    /data/models \
    /data/snapshots \
    /data/logs \
    /data/user_scripts

RUN chmod +x /app/app/entrypoint.sh

# 设置数据卷
VOLUME ["/data"]

# 暴露端口（如果有Web服务）
EXPOSE 5000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python3 -c "import sys; sys.exit(0)" || exit 1

WORKDIR /app/app

ENV TZ=Asia/Shanghai
ENV PYTHONPATH="/app:$PYTHONPATH"

# 设置入口点
ENTRYPOINT ["./entrypoint.sh"]

# 标签信息
LABEL maintainer="Video BA Pipe Team" \
      version="1.0" \
      description="Video Behavior Analysis Pipeline - X86 + CUDA/GPU Version" \
      gpu.enabled="true"
