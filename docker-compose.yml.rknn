x-logging: &default-logging
  driver: "json-file"
  options:
    max-size: "10m"
    max-file: "3"

# 解码与硬解预算(CMA 探针)共享配置,通过 YAML anchor 保持一致
x-hw-decode-environment: &hw-decode-environment
  VIDEO_DECODER_TYPE: ${VIDEO_DECODER_TYPE:-rk_mpp}
  HW_DECODE_BUDGET_ENABLED: ${HW_DECODE_BUDGET_ENABLED:-true}
  HW_DECODE_MIN_SLOTS: ${HW_DECODE_MIN_SLOTS:-1}
  HW_DECODE_MAX_SLOTS: ${HW_DECODE_MAX_SLOTS:-32}
  HW_DECODE_CMA_PER_INSTANCE_MB: ${HW_DECODE_CMA_PER_INSTANCE_MB:-16}
  HW_DECODE_CMA_RESERVE_MB: ${HW_DECODE_CMA_RESERVE_MB:-160}
  HW_DECODE_SW_FALLBACK_ENABLED: ${HW_DECODE_SW_FALLBACK_ENABLED:-true}
  HW_DECODE_SW_FALLBACK_MAX: ${HW_DECODE_SW_FALLBACK_MAX:-0}

# api 与 worker 共享的应用环境变量(含硬解预算/路径/录制/告警/RabbitMQ/时区)
x-app-environment: &app-environment
  <<: *hw-decode-environment
  TZ: Asia/Shanghai
  PATH: /opt/ffmpeg/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
  LD_LIBRARY_PATH: /opt/ffmpeg/lib:/opt/ffmpeg/lib64:/opt/rknn/lib:/usr/local/lib:/usr/lib/aarch64-linux-gnu
  DB_BACKEND: ${DB_BACKEND:-postgres}
  DB_HOST: ${DB_HOST:-postgres}
  DB_PORT: ${DB_PORT:-5432}
  DB_NAME: ${DB_NAME:-video_ba_pipe}
  DB_USER: ${DB_USER:-video_ba_pipe}
  DB_PASSWORD: ${DB_PASSWORD:-video_ba_pipe}
  DB_SSLMODE: ${DB_SSLMODE:-disable}
  # 节点唯一编码；集群/多盒子部署每台必须唯一，留空则自动生成 UUID 并持久化到 /data/node_id.json
  NODE_ID: ${NODE_ID:-}
  PUBLIC_BASE_URL: ${PUBLIC_BASE_URL:-}
  MEDIA_URL_SIGNING_ENABLED: ${MEDIA_URL_SIGNING_ENABLED:-true}
  MEDIA_URL_TTL_HOURS: ${MEDIA_URL_TTL_HOURS:-24}
  MEDIA_URL_SIGNING_SECRET: ${MEDIA_URL_SIGNING_SECRET:-}
  JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
  WEBHOOK_ALLOWED_HOSTS: ${WEBHOOK_ALLOWED_HOSTS:-oapi.dingtalk.com,api.day.app}
  FRAME_SAVE_PATH: /data/frames
  VIDEO_SAVE_PATH: /data/videos
  VIDEO_SOURCE_PATH: /data/video_sources
  MODEL_SAVE_PATH: /data/models
  USER_SCRIPTS_ROOT: /data/user_scripts
  SNAPSHOT_PATH: /data/snapshots
  VIDEO_FRAME_PIXEL_FORMAT: ${VIDEO_FRAME_PIXEL_FORMAT:-nv12}
  IS_EXTREME_DECODE_MODE: ${IS_EXTREME_DECODE_MODE:-true}
  DECODER_OUTPUT_QUEUE_SIZE: ${DECODER_OUTPUT_QUEUE_SIZE:-2}
  ANALYSIS_TARGET_FPS: ${ANALYSIS_TARGET_FPS:-2}
  ANALYSIS_BUFFER_SECONDS: ${ANALYSIS_BUFFER_SECONDS:-3}
  RECORDING_ENABLED: ${RECORDING_ENABLED:-false}
  PRE_ALERT_DURATION: ${PRE_ALERT_DURATION:-15}
  POST_ALERT_DURATION: ${POST_ALERT_DURATION:-15}
  RECORDING_FPS: ${RECORDING_FPS:-3}
  RECORDING_BUFFER_DURATION: ${RECORDING_BUFFER_DURATION:-32}
  RECORDING_JPEG_QUALITY: ${RECORDING_JPEG_QUALITY:-80}
  WORKFLOW_ZERO_COPY_FRAMES: ${WORKFLOW_ZERO_COPY_FRAMES:-false}
  SOURCE_HOST_WORKFLOW_NODE_WORKERS: ${SOURCE_HOST_WORKFLOW_NODE_WORKERS:-0}
  RESOURCE_PROFILING_ENABLED: ${RESOURCE_PROFILING_ENABLED:-false}
  ALERT_SUPPRESSION_DURATION: "60"
  ALERT_IMAGE_CLEANUP_ENABLED: "true"
  ALERT_IMAGE_RETENTION_DAYS: "7"
  WINDOW_DETECTION_RETENTION_HOURS: "24"
  ALERT_IMAGE_MAX_STORAGE_GB: ${ALERT_IMAGE_MAX_STORAGE_GB:-10}
  ALERT_VIDEO_MAX_STORAGE_GB: ${ALERT_VIDEO_MAX_STORAGE_GB:-20}
  ALERT_IMAGE_MIN_FREE_GB: ${ALERT_IMAGE_MIN_FREE_GB:-10}
  MEDIA_CLEANUP_INTERVAL_SECONDS: ${MEDIA_CLEANUP_INTERVAL_SECONDS:-60}
  RABBITMQ_ENABLED: "true"
  RABBITMQ_HOST: rabbitmq
  RABBITMQ_PORT: "5672"
  RABBITMQ_USER: admin
  RABBITMQ_PASSWORD: admin123
  RABBITMQ_VHOST: /
  RABBITMQ_ALERT_QUEUE: video_alerts
  RABBITMQ_ALERT_EXCHANGE: video_alerts
  RABBITMQ_ALERT_ROUTING_KEY: alert

services:
  postgres:
    image: postgres:16-alpine
    container_name: video-ba-pipe-postgres-rk
    restart: unless-stopped
    environment:
      - POSTGRES_DB=${POSTGRES_DB:-video_ba_pipe}
      - POSTGRES_USER=${POSTGRES_USER:-video_ba_pipe}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-video_ba_pipe}
      - TZ=Asia/Shanghai
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - postgres-data:/var/lib/postgresql/data
    networks:
      - video-ba-network
    logging: *default-logging
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-video_ba_pipe} -d ${POSTGRES_DB:-video_ba_pipe}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 15s

  db-init:
    image: ghcr.io/zuoa/video-ba-pipe:rk
    container_name: video-ba-pipe-db-init-rk
    restart: "no"
    entrypoint: ["python3", "-m", "app.setup_database"]
    environment:
      DB_BACKEND: ${DB_BACKEND:-postgres}
      DB_HOST: ${DB_HOST:-postgres}
      DB_PORT: ${DB_PORT:-5432}
      DB_NAME: ${DB_NAME:-video_ba_pipe}
      DB_USER: ${DB_USER:-video_ba_pipe}
      DB_PASSWORD: ${DB_PASSWORD:-video_ba_pipe}
      DB_SSLMODE: ${DB_SSLMODE:-disable}
      DB_SCHEMA_LOCK_TIMEOUT_SECONDS: ${DB_SCHEMA_LOCK_TIMEOUT_SECONDS:-120}
      TZ: Asia/Shanghai
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./data:/data
    networks:
      - video-ba-network
    logging: *default-logging
    depends_on:
      postgres:
        condition: service_healthy

  api:
    image: ghcr.io/zuoa/video-ba-pipe:rk
    container_name: video-ba-pipe-rknn
    restart: unless-stopped
    shm_size: '8gb'
    entrypoint: ["gunicorn", "-w", "${WEB_CONCURRENCY:-1}", "--timeout", "${WEB_REQUEST_TIMEOUT_SECONDS:-1800}", "--bind", "0.0.0.0:5002", "web.webapp:app"]

    # 环境变量
    environment:
      <<: *app-environment
      COMPANY_NAME: ${COMPANY_NAME:-码全科技}
      HF_USE_MIRROR: ${HF_USE_MIRROR:-false}
      HF_MIRROR_ENDPOINT: ${HF_MIRROR_ENDPOINT:-https://hf-mirror.com}
      HF_DOWNLOAD_TIMEOUT_SECONDS: ${HF_DOWNLOAD_TIMEOUT_SECONDS:-120}
      HF_TOKEN: ${HF_TOKEN:-}

    # 数据卷挂载
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./data:/data
      - /opt/rknn:/opt/rknn:ro

    depends_on:
      db-init:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy

    # 端口映射
    ports:
      - "5002:5002"

    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5002/api/health/ready', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

    # 网络配置
    networks:
      video-ba-network:
        aliases:
          - api
          - app

    # 日志配置
    logging: *default-logging

  worker:
    image: ghcr.io/zuoa/video-ba-pipe:rk
    container_name: video-ba-pipe-worker
    restart: unless-stopped
    init: true
    # 需要 privileged:RKNNLite init_runtime 会读 /proc/device-tree/compatible 确认平台,
    # 该路径是 /sys/firmware/devicetree/base 的软链,而 Docker 默认 mask 了 /sys/firmware,
    # 普通挂载无法绕过(bind 到软链路径无效),只能用 privileged 解除 mask。
    privileged: true
    shm_size: '8gb'
    entrypoint: ["python", "main.py"]
    environment:
      <<: *app-environment
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./data:/data
      - /opt/rknn:/opt/rknn:ro
      # rknnlite 在容器内按硬编码路径 /usr/lib/librknnrt.so 加载运行时库,
      # 镜像未内置该库,需把宿主机 librknnrt.so 映射进来(否则 init_runtime 报找不到动态库)。
      - /usr/lib/librknnrt.so:/usr/lib/librknnrt.so:ro
    depends_on:
      db-init:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
    devices:
      - /dev/dri:/dev/dri
      - /dev/mpp_service:/dev/mpp_service
      - /dev/rga:/dev/rga
      - /dev/video0:/dev/video0
    networks:
      - video-ba-network

    # 日志配置
    logging: *default-logging

    # 性能优化建议
    # CPU版本可能需要限制资源使用
    # deploy:
    #   resources:
    #     limits:
    #       cpus: '4'
    #       memory: 8G

  # ============================================
  # 前端 (Nginx)
  # ============================================
  frontend:
    image: ghcr.io/zuoa/video-ba-pipe-frontend:rk
    container_name: video-ba-pipe-frontend
    restart: unless-stopped
    environment:
      - TZ=Asia/Shanghai
    volumes:
      - /etc/localtime:/etc/localtime:ro
    depends_on:
      api:
        condition: service_healthy
    ports:
      - "8080:80"
    networks:
      - video-ba-network
    logging: *default-logging

networks:
  video-ba-network:
    driver: bridge

volumes:
  postgres-data:
    driver: local
