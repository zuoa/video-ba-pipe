version: '3.8'

# 解码与硬解预算(NVDEC)共享配置,app 与 worker 通过 YAML anchor 保持一致
x-hw-decode-environment: &hw-decode-environment
  VIDEO_DECODER_TYPE: ${VIDEO_DECODER_TYPE:-ffmpeg_nvdec}
  HW_DECODE_BUDGET_ENABLED: ${HW_DECODE_BUDGET_ENABLED:-true}
  HW_DECODE_MIN_SLOTS: ${HW_DECODE_MIN_SLOTS:-1}
  HW_DECODE_MAX_SLOTS: ${HW_DECODE_MAX_SLOTS:-32}
  HW_DECODE_NV_UTIL_THRESHOLD: ${HW_DECODE_NV_UTIL_THRESHOLD:-85}
  HW_DECODE_NV_VRAM_PER_INSTANCE_MB: ${HW_DECODE_NV_VRAM_PER_INSTANCE_MB:-128}
  HW_DECODE_NV_VRAM_RESERVE_MB: ${HW_DECODE_NV_VRAM_RESERVE_MB:-1024}
  HW_DECODE_NV_GPU_INDEX: ${HW_DECODE_NV_GPU_INDEX:-0}
  HW_DECODE_NV_INITIAL_SLOTS: ${HW_DECODE_NV_INITIAL_SLOTS:-0}
  HW_DECODE_SW_FALLBACK_ENABLED: ${HW_DECODE_SW_FALLBACK_ENABLED:-true}
  HW_DECODE_SW_FALLBACK_MAX: ${HW_DECODE_SW_FALLBACK_MAX:-0}

services:
  postgres:
    image: postgres:16-alpine
    container_name: video-ba-pipe-postgres-cuda
    restart: unless-stopped
    environment:
      - POSTGRES_DB=${POSTGRES_DB:-video_ba_pipe}
      - POSTGRES_USER=${POSTGRES_USER:-video_ba_pipe}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-video_ba_pipe}
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - video-ba-network
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-video_ba_pipe} -d ${POSTGRES_DB:-video_ba_pipe}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 15s

  # ============================================
  # X86 + CUDA/GPU版本服务
  # 需要宿主机安装 NVIDIA Docker Runtime
  # 默认使用 NVDEC 硬解(ffmpeg_nvdec),由硬解预算器按
  # NVML 解码引擎利用率 + GPU 型号查表自动限制并发路数
  # ============================================
  app:
    image: ${VIDEO_BA_PIPE_CUDA_IMAGE:-ghcr.io/zuoa/video-ba-pipe:cuda}
    pull_policy: always
    container_name: video-ba-pipe-api-cuda
    restart: unless-stopped
    shm_size: '8gb'
    entrypoint: ["gunicorn", "-w", "4", "--timeout", "${WEB_REQUEST_TIMEOUT_SECONDS:-1800}", "--bind", "0.0.0.0:5002", "web.webapp:app"]

    # GPU配置 - 使用所有可用GPU
    gpus: all
    environment:
      # 解码与硬解预算(NVDEC),与 worker 共享同一 anchor
      <<: *hw-decode-environment
      # GPU相关环境变量
      NVIDIA_VISIBLE_DEVICES: "all"
      NVIDIA_DRIVER_CAPABILITIES: compute,utility,video
      COMPANY_NAME: ${COMPANY_NAME:-码全科技}

      # 应用数据路径
      DB_BACKEND: ${DB_BACKEND:-postgres}
      DB_HOST: ${DB_HOST:-postgres}
      DB_PORT: ${DB_PORT:-5432}
      DB_NAME: ${DB_NAME:-video_ba_pipe}
      DB_USER: ${DB_USER:-video_ba_pipe}
      DB_PASSWORD: ${DB_PASSWORD:-video_ba_pipe}
      DB_SSLMODE: ${DB_SSLMODE:-disable}
      FRAME_SAVE_PATH: /data/frames
      VIDEO_SAVE_PATH: /data/videos
      VIDEO_SOURCE_PATH: /data/video_sources
      MODEL_SAVE_PATH: /data/models
      HF_USE_MIRROR: ${HF_USE_MIRROR:-false}
      HF_MIRROR_ENDPOINT: ${HF_MIRROR_ENDPOINT:-https://hf-mirror.com}
      HF_DOWNLOAD_TIMEOUT_SECONDS: ${HF_DOWNLOAD_TIMEOUT_SECONDS:-120}
      HF_TOKEN: ${HF_TOKEN:-}
      USER_SCRIPTS_ROOT: /data/user_scripts
      SNAPSHOT_PATH: /data/snapshots

      # 功能开关
      SNAPSHOT_ENABLED: "true"
      SNAPSHOT_INTERVAL: "60"
      RECORDING_ENABLED: ${RECORDING_ENABLED:-false}
      IS_EXTREME_DECODE_MODE: "false"

      # 录制配置
      PRE_ALERT_DURATION: "30"
      POST_ALERT_DURATION: "30"
      RECORDING_FPS: "25"
      RINGBUFFER_DURATION: "120"
      ALERT_SUPPRESSION_DURATION: "60"

      # RabbitMQ消息队列配置
      RABBITMQ_ENABLED: "true"
      RABBITMQ_HOST: rabbitmq
      RABBITMQ_PORT: "5672"
      RABBITMQ_USER: admin
      RABBITMQ_PASSWORD: admin123
      RABBITMQ_VHOST: /
      RABBITMQ_ALERT_QUEUE: video_alerts
      RABBITMQ_ALERT_EXCHANGE: video_alerts
      RABBITMQ_ALERT_ROUTING_KEY: alert

      # 时区设置
      TZ: Asia/Shanghai
    
    # 数据卷挂载
    volumes:
      - ./data:/data
    
    # 端口映射
    ports:
      - "5002:5002"
    
    # 网络配置
    networks:
      video-ba-network:
        aliases:
          - api
          - app
    
    # 日志配置
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"
    
    # 健康检查
    healthcheck:
      test: ["CMD", "python3", "-c", "import sys; sys.exit(0)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    
    # 依赖服务（如果启用RabbitMQ）
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy

  worker:
    image: ${VIDEO_BA_PIPE_CUDA_IMAGE:-ghcr.io/zuoa/video-ba-pipe:cuda}
    pull_policy: always
    container_name: video-ba-pipe-worker-cuda
    restart: unless-stopped
    init: true
    shm_size: '8gb'
    entrypoint: ["python", "main.py"]
    gpus: all
    environment:
      # 解码与硬解预算(NVDEC),与 app 共享同一 anchor
      <<: *hw-decode-environment
      NVIDIA_VISIBLE_DEVICES: "all"
      NVIDIA_DRIVER_CAPABILITIES: compute,utility,video
      DB_BACKEND: ${DB_BACKEND:-postgres}
      DB_HOST: ${DB_HOST:-postgres}
      DB_PORT: ${DB_PORT:-5432}
      DB_NAME: ${DB_NAME:-video_ba_pipe}
      DB_USER: ${DB_USER:-video_ba_pipe}
      DB_PASSWORD: ${DB_PASSWORD:-video_ba_pipe}
      DB_SSLMODE: ${DB_SSLMODE:-disable}
      FRAME_SAVE_PATH: /data/frames
      VIDEO_SAVE_PATH: /data/videos
      VIDEO_SOURCE_PATH: /data/video_sources
      MODEL_SAVE_PATH: /data/models
      USER_SCRIPTS_ROOT: /data/user_scripts
      SNAPSHOT_PATH: /data/snapshots
      SNAPSHOT_ENABLED: "true"
      SNAPSHOT_INTERVAL: "60"
      RECORDING_ENABLED: ${RECORDING_ENABLED:-false}
      IS_EXTREME_DECODE_MODE: "false"
      PRE_ALERT_DURATION: "30"
      POST_ALERT_DURATION: "30"
      RECORDING_FPS: "25"
      RINGBUFFER_DURATION: "120"
      ALERT_SUPPRESSION_DURATION: "60"
      RABBITMQ_ENABLED: "true"
      RABBITMQ_HOST: rabbitmq
      RABBITMQ_PORT: "5672"
      RABBITMQ_USER: admin
      RABBITMQ_PASSWORD: admin123
      RABBITMQ_VHOST: /
      RABBITMQ_ALERT_QUEUE: video_alerts
      RABBITMQ_ALERT_EXCHANGE: video_alerts
      RABBITMQ_ALERT_ROUTING_KEY: alert
      TZ: Asia/Shanghai
    volumes:
      - ./data:/data
    networks:
      - video-ba-network
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "5"
    healthcheck:
      test: ["CMD", "python3", "-c", "import sys; sys.exit(0)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    depends_on:
      postgres:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy

  # ============================================
  # 前端 (Nginx)
  # ============================================
  frontend:
    image: ${VIDEO_BA_PIPE_FRONTEND_IMAGE:-ghcr.io/zuoa/video-ba-pipe-frontend:main}
    pull_policy: always
    container_name: video-ba-pipe-frontend-cuda
    restart: unless-stopped
    depends_on:
      - app
    ports:
      - "8080:80"
    networks:
      - video-ba-network

  # ============================================
  # RabbitMQ消息队列服务（可选）
  # ============================================
  rabbitmq:
    image: rabbitmq:3.12-management-alpine
    container_name: video-ba-rabbitmq-cuda
    restart: unless-stopped
    
    environment:
      - RABBITMQ_DEFAULT_USER=admin
      - RABBITMQ_DEFAULT_PASS=admin123
      - RABBITMQ_DEFAULT_VHOST=/
    
    ports:
      - "5672:5672"   # AMQP协议端口
      - "15672:15672" # 管理界面端口
    
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    
    networks:
      - video-ba-network
    
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

# ============================================
# 网络配置
# ============================================
networks:
  video-ba-network:
    driver: bridge

# ============================================
# 数据卷
# ============================================
volumes:
  postgres-data:
    driver: local
  rabbitmq-data:
    driver: local
