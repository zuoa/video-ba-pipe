# ============================================
# Video BA Pipe 配置文件示例
# 复制此文件为 .env 并根据需要修改配置
# ============================================

# ============ 页面品牌配置 ============
# 页面 Header 中展示的公司名称
COMPANY_NAME=码全科技

# ============ 安全与公共访问配置 ============
# 生产环境必须替换为随机强密钥，并确保 API 与工作流进程使用相同值
JWT_SECRET=replace-with-a-random-secret
# Webhook、RabbitMQ 和告警 API 中媒体链接使用的外部访问地址
PUBLIC_BASE_URL=https://video.example.com
MEDIA_URL_SIGNING_ENABLED=true
MEDIA_URL_TTL_HOURS=24
# 留空时复用 JWT_SECRET
MEDIA_URL_SIGNING_SECRET=
# 精确 Host 白名单；自定义通用 Webhook 域名必须由管理员添加，端口非默认时写 host:port
WEBHOOK_ALLOWED_HOSTS=oapi.dingtalk.com,api.day.app

# ============ 数据库配置 ============
# 本地直接运行默认走 SQLite；Docker/盒子部署默认走 PostgreSQL。
# 如需本地也切 PostgreSQL，请显式设置 DB_BACKEND=postgres。
# DB_BACKEND=postgres

# 应用数据库连接（PostgreSQL）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=video_ba_pipe
DB_USER=video_ba_pipe
DB_PASSWORD=video_ba_pipe
DB_SSLMODE=prefer

# SQLite 路径（仅 DB_BACKEND=sqlite 时使用）
DB_PATH=./app/data/db/ba.db

# Docker Compose 中 PostgreSQL 服务的初始化账号
# 默认建议与应用连接参数保持一致
POSTGRES_DB=video_ba_pipe
POSTGRES_USER=video_ba_pipe
POSTGRES_PASSWORD=video_ba_pipe

# ============ 存储路径配置 ============
# 预警图片保存路径
FRAME_SAVE_PATH=./app/data/frames

# 预警视频保存路径
VIDEO_SAVE_PATH=./app/data/videos

# 上传视频源文件保存路径
VIDEO_SOURCE_PATH=./app/data/video_sources

# 模型文件保存路径
MODEL_SAVE_PATH=./app/data/models

# ============ Hugging Face 模型拉取 ============
# 未在请求中指定时，是否默认使用国内镜像
HF_USE_MIRROR=false

# 国内镜像地址，可替换为自建兼容镜像
HF_MIRROR_ENDPOINT=https://hf-mirror.com

# 模型下载连接/读取超时（秒）
HF_DOWNLOAD_TIMEOUT_SECONDS=120

# Web 请求最长执行时间（秒），应大于模型下载可能耗时
WEB_REQUEST_TIMEOUT_SECONDS=1800

# 私有或受限仓库 Token（可选，也可在拉取模型时临时填写）
# HF_TOKEN=hf_xxx

# 用户脚本保存路径
USER_SCRIPTS_ROOT=./app/data/user_scripts

# 快照保存路径
SNAPSHOT_PATH=./app/data/snapshots

# 日志保存路径
LOG_SAVE_PATH=./app/data/logs

# ============ 快照配置 ============
# 是否启用定时快照功能
SNAPSHOT_ENABLED=true

# 快照间隔（秒）
SNAPSHOT_INTERVAL=60

# ============ 解码器配置 ============
# 极速解码模式（丢弃中间帧，只取最新帧）
IS_EXTREME_DECODE_MODE=true

# 默认视频解码器类型
# 通用环境建议 ffmpeg_sw；RK3588 建议 rk_mpp；Jetson 建议 jetson_gst
VIDEO_DECODER_TYPE=ffmpeg_sw

# ffmpeg 软件解码线程数
# 多路并发时建议 1-2；数值越大，单路解码更快，但更容易把 CPU 打满
FFMPEG_SW_DECODER_THREADS=1

# 软解只解关键帧时，持续收到码流但无帧输出超过该时间后，
# 仅将该视频源自动切换为全帧软解。
FFMPEG_SW_KEYFRAME_FALLBACK_SECONDS=10
FFMPEG_SW_KEYFRAME_FALLBACK_MIN_BYTES=262144

# 解码输出队列大小（运行时主帧格式，默认 NV12）
# 多路并发建议 3-5；数值越大，内存占用越高
DECODER_OUTPUT_QUEUE_SIZE=2

# 是否输出关键性能埋点日志（帧拷贝、录制编码、workflow耗时等）
RESOURCE_PROFILING_ENABLED=false
RESOURCE_PROFILE_LOG_INTERVAL_SECONDS=30

# 是否输出逐帧、逐节点 workflow 诊断日志；多路生产环境建议关闭
WORKFLOW_FRAME_LOGS_ENABLED=false

# Source host 是否使用共享内存只读视图读取最新帧，减少复制。
# 仅在 workflow 处理耗时稳定小于 ANALYSIS_TARGET_FPS * ANALYSIS_BUFFER_SECONDS 对应缓冲窗口时开启。
WORKFLOW_ZERO_COPY_FRAMES=false

# 实时 workflow 同层节点并行 worker 数；0 表示关闭并行。
SOURCE_HOST_WORKFLOW_NODE_WORKERS=0

# 共享模型子进程加载权重并完成设备 warm-up 的最长等待时间；不计入单帧请求超时。
SHARED_INFERENCE_STARTUP_TIMEOUT_SECONDS=180

# 轮转源启动超时，以及告警后录完成后的额外排空余量（秒）
SOURCE_ROTATION_STARTUP_TIMEOUT_SECONDS=60
SOURCE_ROTATION_DRAIN_GRACE_SECONDS=15
SOURCE_ROTATION_CONFIG_REFRESH_SECONDS=5

# ============ 硬解资源准入与重启退避 ============
# 硬解准入控制器：按硬件资源自适应限制硬解并发数
# （Jetson/RK 依据 CMA 余量；X86+CUDA 依据 NVDEC 利用率 + GPU 型号查表），防止资源耗尽
HW_DECODE_BUDGET_ENABLED=true
# 每路硬解 CMA 估算（MB，Jetson Orin 1080p 以下约 12MB）与系统常驻预留（MB）
HW_DECODE_CMA_PER_INSTANCE_MB=16
HW_DECODE_CMA_RESERVE_MB=160
# 硬解并发槽位上下限
HW_DECODE_MIN_SLOTS=1
HW_DECODE_MAX_SLOTS=32
# 硬解不足时自动软解兜底；HW_DECODE_SW_FALLBACK_MAX 限制软解路数（0=不限）
# 注意：每路软解约占 1 核 CPU，路数多时建议设置上限（如 CPU 核数的一半）
HW_DECODE_SW_FALLBACK_ENABLED=true
HW_DECODE_SW_FALLBACK_MAX=0
# 软解源自动升级回硬解的检查间隔（秒）
HW_DECODE_UPGRADE_INTERVAL_SECONDS=60
# ---- X86 + CUDA(NVDEC)容量探针 ----
# NVDEC 解码引擎利用率闸门（%），达到后不再发放新硬解槽位
HW_DECODE_NV_UTIL_THRESHOLD=85
# 每路 NVDEC 显存估算（MB）与为推理等负载保留的空闲显存（MB）
HW_DECODE_NV_VRAM_PER_INSTANCE_MB=128
HW_DECODE_NV_VRAM_RESERVE_MB=1024
# NVDEC 解码使用的 GPU 序号（与 ffmpeg -hwaccel_device 对应）
HW_DECODE_NV_GPU_INDEX=0
# NVDEC 初始槽位覆盖值（0=按 GPU 型号查表自动估算）
HW_DECODE_NV_INITIAL_SLOTS=0
# 解码器重启退避上限（秒），初始退避：流错误 30s / 崩溃 5s，指数增长至该上限
SOURCE_RESTART_BACKOFF_MAX_SECONDS=300
# 每个管理周期最多启动的视频源数量（防批量启动惊群）
SOURCE_MAX_CONCURRENT_STARTS=2

# 推理 OOM 熔断、共享模型服务与内存准入。
# 这些变量只作为首次启动和数据库不可用时的默认值；初始化后请在
# “系统设置 → 推理资源保护”中统一配置，worker 会自动热应用。
OOM_CIRCUIT_BREAKER_ENABLED=true
OOM_CIRCUIT_FAILURE_THRESHOLD=3
OOM_CIRCUIT_OPEN_SECONDS=600
OOM_CIRCUIT_STABLE_RESET_SECONDS=600
OOM_RESTART_BACKOFF_MAX_SECONDS=300
SHARED_INFERENCE_ENABLED=false
SHARED_INFERENCE_SOCKET_PATH=/tmp/video-ba-pipe-inference.sock
SHARED_INFERENCE_QUEUE_SIZE=2
SHARED_INFERENCE_BATCH_MAX_SIZE=4
SHARED_INFERENCE_BATCH_WAIT_MS=5
SHARED_INFERENCE_REQUEST_TIMEOUT_SECONDS=30
SHARED_INFERENCE_IDLE_SECONDS=120
# 页面算法测试由 worker 内部服务执行；生产环境请替换默认 token。
ALGORITHM_TEST_WORKER_URL=http://worker:5010
# 非 Compose/单机启动默认仅监听回环地址；Compose 会显式覆盖为 0.0.0.0。
ALGORITHM_TEST_WORKER_HOST=127.0.0.1
ALGORITHM_TEST_WORKER_PORT=5010
ALGORITHM_TEST_WORKER_TOKEN=replace-with-a-random-internal-secret
ALGORITHM_TEST_QUEUE_SIZE=2
ALGORITHM_TEST_TIMEOUT_SECONDS=180
ALGORITHM_TEST_MAX_IMAGE_BYTES=20971520
INFERENCE_ADMISSION_ENABLED=false
INFERENCE_SYSTEM_RESERVE_MB=2048
INFERENCE_SYSTEM_RESERVE_PERCENT=15
INFERENCE_NEW_MODEL_DEFAULT_MB=1024
INFERENCE_MODEL_MEMORY_MARGIN_PERCENT=25

# ============ 视频录制配置 ============
# 预警录制功能开关
RECORDING_ENABLED=false

# 录制预警前的时长（秒）
# 建议：10-60秒
# 注意：不能超过 RECORDING_BUFFER_DURATION
PRE_ALERT_DURATION=15

# 录制预警后的时长（秒）
# 建议：10-60秒
POST_ALERT_DURATION=15

# 录制视频的帧率（FPS）
# 建议：5-15fps
# 说明：帧率越高视频越流畅，但占用存储和CPU更多
# - 5fps：适合资源受限环境，视频略有卡顿
# - 10fps：推荐值，平衡流畅度和资源占用
# - 15fps：较流畅，适合高性能服务器
RECORDING_FPS=3

# 分析缓冲区目标帧率（FPS）
# 工作流实时分析只消费最新帧，建议远低于源视频FPS
ANALYSIS_TARGET_FPS=2

# 分析缓冲区时长（秒）
# 仅用于分析链路，建议保持很小（例如 3-5 秒）
ANALYSIS_BUFFER_SECONDS=3

# 录制缓冲区时长（秒）
# 需要覆盖 PRE_ALERT_DURATION + POST_ALERT_DURATION
# 内存占用 ≈ 帧大小(字节) × RECORDING_FPS × RECORDING_BUFFER_DURATION
RECORDING_BUFFER_DURATION=32

# 录制缓冲区 JPEG 质量（仅 recording buffer 使用）
RECORDING_JPEG_QUALITY=80

# 录制缓冲区单帧最大字节数
RECORDING_COMPRESSED_MAX_BYTES=524288

# ============ 告警抑制配置 ============
# 告警抑制时长（秒）
# 说明：同一任务的同一算法在此时间内不会重复触发告警
# 建议：30-120秒，防止频繁告警和重复录制
# 例如：设置为60秒，则告警触发后60秒内检测到相同类型目标也不会再次告警
ALERT_SUPPRESSION_DURATION=60

# ============ 告警存储清理 ============
# worker 启动时立即执行一次，之后按间隔周期执行。
ALERT_IMAGE_CLEANUP_ENABLED=true
ALERT_IMAGE_RETENTION_DAYS=7
ALERT_VIDEO_RETENTION_DAYS=7
ALERT_RECORD_RETENTION_DAYS=30
WINDOW_DETECTION_RETENTION_HOURS=24
ALERT_IMAGE_MAX_STORAGE_GB=10
ALERT_VIDEO_MAX_STORAGE_GB=20
# 可用空间低于该值时，不等待保留期，优先删除最老的告警图片和视频。
ALERT_IMAGE_MIN_FREE_GB=10
MEDIA_CLEANUP_INTERVAL_SECONDS=60

# ============ 检测结果调试日志 ============
# 是否将每次算法检测结果追加写入 logs/detection_results_YYYYMMDD.jsonl
# 默认关闭，排查 RKNN/x86 输出差异时再临时开启
DETECTION_JSONL_LOG_ENABLED=false

# ============ 平台节点身份（集群 / MQ 来源标识）============
# 当前实例的唯一编码。集群或多盒子部署时【必须保证全局唯一】，例如 box-01、edge-sh-03。
# 集群下多台盒子向同一个消息队列推送告警，消费端通过该字段区分来源机器、回溯媒体、去重。
# 留空时：首次启动自动生成 UUID 并写入 NODE_ID_FILE（重启不变）；文件不可写则回退 hostname。
NODE_ID=
# 自动生成 node_id 的持久化文件路径（仅当 NODE_ID 留空时使用）
NODE_ID_FILE=

# MQTT / RabbitMQ 的启用状态、提供方及连接参数统一在“系统设置 → 消息队列”中配置，
# 不再接受消息队列环境变量。

# ============ MediaMTX / WebRTC 实时预览 ============
# 通过 MediaMTX 作为「按需拉流」中继，前端用 WebRTC(WHEP) 直接看实时画面。
# 仅当有浏览器观众时才向摄像机拉 RTSP，观众离开自动断开，避免常驻占资源。
# 默认关闭：置 true 前请确保 docker-compose 已启动 mediamtx 服务。
MEDIAMTX_ENABLED=false

# 后端容器内访问 MediaMTX REST API 的地址（docker 网络内通常为服务名 mediamtx）
MEDIAMTX_API_HOST=mediamtx
MEDIAMTX_API_PORT=9997
# Control API 专用凭据；生产环境必须修改默认密码，compose 会同步给 MediaMTX 与后端。
MEDIAMTX_API_USER=video-ba-api
MEDIAMTX_API_PASSWORD=video-ba-api-change-me
MEDIAMTX_RTSP_PORT=8554
# 浏览器侧连接 WebRTC 的端口（docker host 映射端口）
MEDIAMTX_WEBRTC_PORT=8889
# 浏览器侧访问的主机名/IP；留空则前端用页面所在 hostname 兜底
MEDIAMTX_WEBRTC_PUBLIC_HOST=
# 逗号分隔的额外 ICE 主机，注入 MediaMTX(MTX_WEBRTCADDITIONALHOSTS)，
# 让 ICE 候选对浏览器可达。同局域网部署填「宿主机可达 IP」即可。
# 例：MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=10.0.4.15
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=

# ============ 最新检测帧快照（视频源预览）============
# 视频源管理页「最新检测帧」按钮：周期性保存带算法检测框 + ROI 的标注帧。
# 无活跃 workflow/检测时前端自动回退显示原始快照。
DETECTION_SNAPSHOT_ENABLED=true
# 写入间隔（秒），比原始快照(SNAPSHOT_INTERVAL)更勤
DETECTION_SNAPSHOT_INTERVAL=5

# ============ 性能参考 ============
# 
# 配置方案1（推荐 - RK/资源受限）:
# ANALYSIS_TARGET_FPS=2
# ANALYSIS_BUFFER_SECONDS=3
# RECORDING_FPS=3
# RECORDING_BUFFER_DURATION=32
# PRE_ALERT_DURATION=15
# POST_ALERT_DURATION=15
# 分析共享内存：~18MB/路 (1920×1080, NV12, 2fps, 3s)
# 录制共享内存：~48MB/路 (512KB slot, 3fps, 32s)
# 16路约 1.1GB buffer；32路约 2.1GB buffer（不含模型/进程RSS）
#
# 配置方案2（标准监控）:
# ANALYSIS_TARGET_FPS=3
# ANALYSIS_BUFFER_SECONDS=5
# RECORDING_FPS=10
# RECORDING_BUFFER_DURATION=62
# PRE_ALERT_DURATION=30
# POST_ALERT_DURATION=30
# 分析共享内存：~45MB/路 (1920×1080, NV12, 3fps, 5s)
# 录制共享内存：~310MB/路 (512KB slot, 10fps, 62s)
# 32路仅录制缓存约 9.7GB，RK盒子不建议作为默认值
#
# 配置方案3（高质量）:
# ANALYSIS_TARGET_FPS=5
# ANALYSIS_BUFFER_SECONDS=5
# RECORDING_FPS=15
# RECORDING_BUFFER_DURATION=92
# PRE_ALERT_DURATION=45
# POST_ALERT_DURATION=45
# 录制内存占用：~8.2GB (1920×1080, 15fps, 92s)
# 视频时长：90秒
# 文件大小：~40-80MB/视频
#
# 配置方案4（更低资源）:
# ANALYSIS_TARGET_FPS=2
# ANALYSIS_BUFFER_SECONDS=3
# RECORDING_FPS=5
# RECORDING_BUFFER_DURATION=42
# PRE_ALERT_DURATION=20
# POST_ALERT_DURATION=20
# 录制内存占用：~1.3GB (1920×1080, 5fps, 42s)
# 视频时长：40秒
# 文件大小：~8-15MB/视频
