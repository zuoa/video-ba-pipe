version: '3.8'

x-logging: &default-logging
  driver: "json-file"
  options:
    max-size: "10m"
    max-file: "3"

# app 与 worker 日志量较大,使用更大的滚动切片
x-app-logging: &app-logging
  driver: "json-file"
  options:
    max-size: "50m"
    max-file: "5"

# 解码与硬解预算(NVDEC)共享配置,通过 YAML anchor 保持一致
x-hw-decode-environment: &hw-decode-environment
  VIDEO_DECODER_TYPE: ${VIDEO_DECODER_TYPE:-ffmpeg_nvdec}
  HW_DECODE_BUDGET_ENABLED: ${HW_DECODE_BUDGET_ENABLED:-true}
  HW_DECODE_MIN_SLOTS: ${HW_DECODE_MIN_SLOTS:-1}
  HW_DECODE_MAX_SLOTS: ${HW_DECODE_MAX_SLOTS:-32}
  HW_DECODE_NV_UTIL_THRESHOLD: ${HW_DECODE_NV_UTIL_THRESHOLD:-85}
  HW_DECODE_NV_VRAM_PER_INSTANCE_MB: ${HW_DECODE_NV_VRAM_PER_INSTANCE_MB:-128}
  HW_DECODE_NV_VRAM_RESERVE_MB: ${HW_DECODE_NV_VRAM_RESERVE_MB:-1024}
  HW_DECODE_NV_GPU_INDEX: ${HW_DECODE_NV_GPU_INDEX:-0}
  HW_DECODE_NV_INITIAL_SLOTS: ${HW_DECODE_NV_INITIAL_SLOTS:-0}
  HW_DECODE_SW_FALLBACK_ENABLED: ${HW_DECODE_SW_FALLBACK_ENABLED:-true}
  HW_DECODE_SW_FALLBACK_MAX: ${HW_DECODE_SW_FALLBACK_MAX:-0}

# app 与 worker 共享的应用环境变量（消息队列连接参数由系统设置页面管理）
x-app-environment: &app-environment
  <<: *hw-decode-environment
  NVIDIA_VISIBLE_DEVICES: "all"
  NVIDIA_DRIVER_CAPABILITIES: compute,utility,video
  DB_BACKEND: ${DB_BACKEND:-postgres}
  DB_HOST: ${DB_HOST:-postgres}
  DB_PORT: ${DB_PORT:-5432}
  DB_NAME: ${DB_NAME:-video_ba_pipe}
  DB_USER: ${DB_USER:-video_ba_pipe}
  DB_PASSWORD: ${DB_PASSWORD:-video_ba_pipe}
  DB_SSLMODE: ${DB_SSLMODE:-disable}
  # 节点唯一编码；集群/多盒子部署每台必须唯一，留空则优先使用 MAC 并持久化到 /data/node_id.json
  NODE_ID: ${NODE_ID:-}
  DEVICE_MODEL_CODE: ${DEVICE_MODEL_CODE:-}
  LICENSE_PUBLIC_KEY_PATH: ${LICENSE_PUBLIC_KEY_PATH:-/app/app/license_public_key.pem}
  PUBLIC_BASE_URL: ${PUBLIC_BASE_URL:-}
  MEDIA_URL_SIGNING_ENABLED: ${MEDIA_URL_SIGNING_ENABLED:-true}
  MEDIA_URL_TTL_HOURS: ${MEDIA_URL_TTL_HOURS:-24}
  MEDIA_URL_SIGNING_SECRET: ${MEDIA_URL_SIGNING_SECRET:-}
  JWT_SECRET: ${JWT_SECRET:-your-secret-key-change-in-production}
  ALGORITHM_TEST_WORKER_URL: ${ALGORITHM_TEST_WORKER_URL:-http://worker:5010}
  ALGORITHM_TEST_WORKER_HOST: 0.0.0.0
  ALGORITHM_TEST_WORKER_PORT: ${ALGORITHM_TEST_WORKER_PORT:-5010}
  ALGORITHM_TEST_WORKER_TOKEN: ${ALGORITHM_TEST_WORKER_TOKEN:-video-ba-pipe-internal-test-v1}
  ALGORITHM_TEST_QUEUE_SIZE: ${ALGORITHM_TEST_QUEUE_SIZE:-2}
  ALGORITHM_TEST_TIMEOUT_SECONDS: ${ALGORITHM_TEST_TIMEOUT_SECONDS:-180}
  ALGORITHM_TEST_MAX_IMAGE_BYTES: ${ALGORITHM_TEST_MAX_IMAGE_BYTES:-20971520}
  WEBHOOK_ALLOWED_HOSTS: ${WEBHOOK_ALLOWED_HOSTS:-oapi.dingtalk.com,api.day.app}
  FRAME_SAVE_PATH: /data/frames
  VIDEO_SAVE_PATH: /data/videos
  VIDEO_SOURCE_PATH: /data/video_sources
  MODEL_SAVE_PATH: /data/models
  FACE_DATA_PATH: /data/face
  FACE_DATA_ENCRYPTION_KEY_FILE: ${FACE_DATA_ENCRYPTION_KEY_FILE:-}
  FACE_DATA_ENCRYPTION_KEY: ${FACE_DATA_ENCRYPTION_KEY:-}
  FACE_INFERENCE_PLUGIN_MODULES: ${FACE_INFERENCE_PLUGIN_MODULES:-}
  USER_SCRIPTS_ROOT: /data/user_scripts
  SNAPSHOT_PATH: /data/snapshots
  SNAPSHOT_ENABLED: "true"
  SNAPSHOT_INTERVAL: "60"
  RECORDING_ENABLED: ${RECORDING_ENABLED:-false}
  IS_EXTREME_DECODE_MODE: "false"
  DECODE_KEYFRAMES_ONLY: ${DECODE_KEYFRAMES_ONLY:-false}
  PRE_ALERT_DURATION: "30"
  POST_ALERT_DURATION: "30"
  RECORDING_FPS: "25"
  RINGBUFFER_DURATION: "120"
  ALERT_SUPPRESSION_DURATION: "60"
  # MediaMTX / WebRTC 实时预览（按需拉流中继，默认关闭）
  MEDIAMTX_ENABLED: ${MEDIAMTX_ENABLED:-false}
  MEDIAMTX_API_HOST: mediamtx
  MEDIAMTX_API_PORT: "9997"
  MEDIAMTX_API_USER: ${MEDIAMTX_API_USER:-video-ba-api}
  MEDIAMTX_API_PASSWORD: ${MEDIAMTX_API_PASSWORD:-video-ba-api-change-me}
  MEDIAMTX_RTSP_PORT: "8554"
  MEDIAMTX_WEBRTC_PORT: "8889"
  MEDIAMTX_WEBRTC_PUBLIC_HOST: ${MEDIAMTX_WEBRTC_PUBLIC_HOST:-}
  MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS: ${MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS:-}
  TZ: Asia/Shanghai
  # API 不加载模型；仅 worker 覆盖为 true。
  SHARED_INFERENCE_ENABLED: "false"
  SHARED_INFERENCE_SOCKET_PATH: ${SHARED_INFERENCE_SOCKET_PATH:-/tmp/video-ba-pipe-inference.sock}
  GPU_SCHEDULING_ENABLED: ${GPU_SCHEDULING_ENABLED:-true}
  GPU_SCHEDULING_POLICY: ${GPU_SCHEDULING_POLICY:-balanced}
  GPU_ALLOWED_DEVICES: ${GPU_ALLOWED_DEVICES:-}
  GPU_MEMORY_RESERVE_MB: ${GPU_MEMORY_RESERVE_MB:-1024}
  GPU_NEW_MODEL_DEFAULT_MB: ${GPU_NEW_MODEL_DEFAULT_MB:-2048}
  GPU_MODEL_MEMORY_MARGIN_PERCENT: ${GPU_MODEL_MEMORY_MARGIN_PERCENT:-25}
  GPU_OOM_COOLDOWN_SECONDS: ${GPU_OOM_COOLDOWN_SECONDS:-60}
  GPU_NVML_STALE_SECONDS: ${GPU_NVML_STALE_SECONDS:-60}
  GPU_SCHEDULING_FAILURE_MODE: ${GPU_SCHEDULING_FAILURE_MODE:-reject}

services:
  postgres:
    image: postgres:16-alpine
    container_name: video-ba-pipe-postgres-cuda
    restart: unless-stopped
    environment:
      - POSTGRES_DB=${POSTGRES_DB:-video_ba_pipe}
      - POSTGRES_USER=${POSTGRES_USER:-video_ba_pipe}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-video_ba_pipe}
      - TZ=Asia/Shanghai
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - postgres-data:/var/lib/postgresql/data
    networks:
      - video-ba-network
    logging: *default-logging
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-video_ba_pipe} -d ${POSTGRES_DB:-video_ba_pipe}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 15s

  db-init:
    image: ${VIDEO_BA_PIPE_CUDA_IMAGE:-ghcr.io/zuoa/video-ba-pipe:cuda}
    pull_policy: always
    container_name: video-ba-pipe-db-init-cuda
    restart: "no"
    entrypoint: ["python3", "-m", "app.setup_database"]
    environment:
      DB_BACKEND: ${DB_BACKEND:-postgres}
      DB_HOST: ${DB_HOST:-postgres}
      DB_PORT: ${DB_PORT:-5432}
      DB_NAME: ${DB_NAME:-video_ba_pipe}
      DB_USER: ${DB_USER:-video_ba_pipe}
      DB_PASSWORD: ${DB_PASSWORD:-video_ba_pipe}
      DB_SSLMODE: ${DB_SSLMODE:-disable}
      DB_SCHEMA_LOCK_TIMEOUT_SECONDS: ${DB_SCHEMA_LOCK_TIMEOUT_SECONDS:-120}
      TZ: Asia/Shanghai
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./data:/data
    networks:
      - video-ba-network
    logging: *default-logging
    depends_on:
      postgres:
        condition: service_healthy

  # ============================================
  # X86 + CUDA/GPU版本服务
  # 需要宿主机安装 NVIDIA Docker Runtime
  # 默认使用 NVDEC 硬解(ffmpeg_nvdec),由硬解预算器按
  # NVML 解码引擎利用率 + GPU 型号查表自动限制并发路数
  # ============================================
  app:
    image: ${VIDEO_BA_PIPE_CUDA_IMAGE:-ghcr.io/zuoa/video-ba-pipe:cuda}
    pull_policy: always
    container_name: video-ba-pipe-api-cuda
    restart: unless-stopped
    shm_size: '8gb'
    entrypoint: ["gunicorn", "-w", "4", "--timeout", "${WEB_REQUEST_TIMEOUT_SECONDS:-1800}", "--bind", "0.0.0.0:5002", "web.webapp:app"]

    # GPU配置 - 使用所有可用GPU
    gpus: all
    environment:
      <<: *app-environment
      COMPANY_NAME: ${COMPANY_NAME:-码全科技}
      HF_USE_MIRROR: ${HF_USE_MIRROR:-false}
      HF_MIRROR_ENDPOINT: ${HF_MIRROR_ENDPOINT:-https://hf-mirror.com}
      HF_DOWNLOAD_TIMEOUT_SECONDS: ${HF_DOWNLOAD_TIMEOUT_SECONDS:-120}
      HF_TOKEN: ${HF_TOKEN:-}

    # 数据卷挂载
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./data:/data
      # 仪表盘宿主网络速率：只读采集默认出口网卡计数，无需特权模式
      - /proc/net/dev:/host/proc/net/dev:ro
      - /proc/net/route:/host/proc/net/route:ro
      # 只读挂载宿主机 DRM 节点,消除 ONNX Runtime 启动时
      # device_discovery.cc 读取 /sys/class/drm/card0/device/vendor 失败的告警
      # (NVIDIA Container Runtime 不会注入 /sys/class/drm,故需显式挂载)
      - /sys/class/drm:/sys/class/drm:ro

    # 端口映射
    ports:
      - "5002:5002"

    # 网络配置
    networks:
      video-ba-network:
        aliases:
          - api
          - app

    # 日志配置
    logging: *app-logging

    # 健康检查
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5002/api/health/ready', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

    depends_on:
      db-init:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy

  worker:
    image: ${VIDEO_BA_PIPE_CUDA_IMAGE:-ghcr.io/zuoa/video-ba-pipe:cuda}
    pull_policy: always
    container_name: video-ba-pipe-worker-cuda
    restart: unless-stopped
    init: true
    shm_size: '8gb'
    entrypoint: ["python3", "main.py"]
    gpus: all
    environment:
      <<: *app-environment
      SHARED_INFERENCE_ENABLED: ${SHARED_INFERENCE_ENABLED:-true}
      # CUDA/PyTorch 冷启动与稳态单帧推理使用独立超时。
      SHARED_INFERENCE_STARTUP_TIMEOUT_SECONDS: ${SHARED_INFERENCE_STARTUP_TIMEOUT_SECONDS:-180}
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./data:/data
      # 只读挂载宿主机 DRM 节点,消除 ONNX Runtime device_discovery 告警(同 app)
      - /sys/class/drm:/sys/class/drm:ro
    networks:
      - video-ba-network
    logging: *app-logging
    healthcheck:
      test: ["CMD", "python3", "-c", "import sys; sys.exit(0)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    depends_on:
      db-init:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy

  # ============================================
  # 前端 (Nginx)
  # ============================================
  frontend:
    image: ${VIDEO_BA_PIPE_FRONTEND_IMAGE:-ghcr.io/zuoa/video-ba-pipe-frontend:main}
    pull_policy: always
    container_name: video-ba-pipe-frontend-cuda
    restart: unless-stopped
    environment:
      - TZ=Asia/Shanghai
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./frontend/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./data:/data:ro
    depends_on:
      app:
        condition: service_healthy
    ports:
      - "8080:80"
    networks:
      - video-ba-network

  # ============================================
  # RabbitMQ消息队列服务（可选）
  # ============================================
  rabbitmq:
    image: rabbitmq:4.3-management-alpine
    container_name: video-ba-rabbitmq-cuda
    restart: unless-stopped

    environment:
      - RABBITMQ_DEFAULT_USER=admin
      - RABBITMQ_DEFAULT_PASS=admin123
      - RABBITMQ_DEFAULT_VHOST=/
      - TZ=Asia/Shanghai

    ports:
      - "5672:5672"   # AMQP协议端口
      - "15672:15672" # 管理界面端口

    volumes:
      - /etc/localtime:/etc/localtime:ro
      - rabbitmq-data:/var/lib/rabbitmq

    networks:
      - video-ba-network

    logging: *default-logging

    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "ping"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

  # MediaMTX 实时预览中继服务（可选，默认 MEDIAMTX_ENABLED=false）
  # WebRTC(WHEP) 按需拉流：仅当有浏览器观众时才向摄像机拉 RTSP，观众离开自动断开。
  # 多架构镜像(amd64/arm64)，CPU/Jetson/RK 通用。
  # ============================================
  mediamtx:
    image: bluenviron/mediamtx:latest
    container_name: video-ba-mediamtx-cuda
    restart: unless-stopped
    environment:
      - TZ=Asia/Shanghai
      - MTX_AUTHINTERNALUSERS_1_USER=${MEDIAMTX_API_USER:-video-ba-api}
      - MTX_AUTHINTERNALUSERS_1_PASS=${MEDIAMTX_API_PASSWORD:-video-ba-api-change-me}
      # 让 ICE 候选对浏览器可达；填宿主机可达 IP（逗号分隔），同局域网填宿主机 LAN IP
      - MTX_WEBRTCADDITIONALHOSTS=${MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS:-}
    ports:
      - "8889:8889/tcp" # WebRTC WHEP/HTTP signaling
      - "8189:8189/udp" # WebRTC ICE media
      - "8189:8189/tcp" # WebRTC ICE TCP fallback
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - ./mediamtx.yml:/mediamtx.yml:ro
    networks:
      - video-ba-network
    logging: *default-logging

# ============================================
# 网络配置
# ============================================
networks:
  video-ba-network:
    driver: bridge

# ============================================
# 数据卷
# ============================================
volumes:
  postgres-data:
    driver: local
  rabbitmq-data:
    driver: local
