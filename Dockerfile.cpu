# ============================================
# Video BA Pipe - CPU版本
# 适用于无GPU的测试和开发环境
# ============================================

# 使用官方Python 3.10 slim镜像
FROM python:3.10-slim-bullseye AS runtime-base

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# 设置工作目录
WORKDIR /app

# 安装系统依赖。
# deb.debian.org 走 Fastly，偶发 Connection reset by peer 会让整层 apt 以 100 退出。
# 国内网络可：docker build --build-arg DEBIAN_MIRROR=mirrors.aliyun.com ...
ARG DEBIAN_MIRROR=
RUN set -eux; \
    if [ -n "${DEBIAN_MIRROR}" ]; then \
      sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g; s|security.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list; \
    fi; \
    echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries; \
    echo 'Acquire::http::Pipeline-Depth "0";' >> /etc/apt/apt.conf.d/80-retries; \
    i=0; \
    until apt-get update && apt-get install -y --no-install-recommends --fix-missing \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender-dev \
        libgomp1 \
        libgl1-mesa-glx \
        fonts-wqy-zenhei \
        ffmpeg \
        libavcodec-dev \
        libavformat-dev \
        libswscale-dev \
        wget \
        curl \
        git \
        postgresql-client \
        tzdata; do \
      i=$((i + 1)); \
      [ "$i" -lt 5 ]; \
      echo "apt-get failed, retry ${i}/5 in 5s"; \
      sleep 5; \
    done; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# 升级pip
RUN python -m pip install --upgrade pip setuptools wheel

# 先安装PyTorch（CPU版本）
RUN pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# 复制依赖文件
COPY requirements.control.txt requirements.worker.txt ./
COPY requirements.ocr.txt .

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.worker.txt
RUN pip install --no-cache-dir paddlepaddle==3.0.0 \
      -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && pip install --no-cache-dir -r requirements.ocr.txt

FROM runtime-base AS worker

# 版本参数只影响轻量应用层，避免每次发布让 GB 级依赖层失效。
ARG APP_VERSION=unknown
ARG BUILD_TIME=unknown
ENV APP_VERSION=${APP_VERSION} \
    BUILD_TIME=${BUILD_TIME}

# 复制应用代码
COPY app/ /app/app/
COPY scripts/ /app/scripts/
COPY docs/openapi.yaml docs/openapi_usage.md /app/docs/
COPY env.example /app/.env.example

# 创建必要的数据目录
RUN mkdir -p /data/db \
    /data/frames \
    /data/videos \
    /data/models \
    /data/snapshots \
    /data/logs \
    /data/user_scripts

RUN chmod +x /app/app/entrypoint.sh

# 设置数据卷
VOLUME ["/data"]

# 暴露端口（如果有Web服务）
EXPOSE 5000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

WORKDIR /app/app

ENV TZ=Asia/Shanghai
# 装了 tzdata 后 TZ=Asia/Shanghai 即生效；再软链 /etc/localtime 作双保险
# （运行时会被 compose 只读挂载的宿主机 /etc/localtime 覆盖，但不影响 TZ 解析）。
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
ENV PYTHONPATH=/app

# 设置入口点
ENTRYPOINT ["./entrypoint.sh"]

# 标签信息
LABEL maintainer="Video BA Pipe Team" \
      version="${APP_VERSION}" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      description="Video Behavior Analysis Pipeline - CPU Version" \
      gpu.enabled="false"
