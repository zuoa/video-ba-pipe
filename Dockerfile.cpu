# ============================================
# Video BA Pipe - CPU版本
# 适用于无GPU的测试和开发环境
# ============================================

# 使用官方Python 3.10 slim镜像
FROM python:3.10-slim-bullseye

# 由镜像构建流程根据最近 Git 提交注入。
ARG APP_VERSION=unknown
ARG BUILD_TIME=unknown

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    APP_VERSION=${APP_VERSION} \
    BUILD_TIME=${BUILD_TIME}

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    # OpenCV依赖
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    fonts-wqy-zenhei \
    # FFmpeg和视频编解码
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    # 其他工具
    wget \
    curl \
    git \
    postgresql-client \
    # slim 镜像不含 /usr/share/zoneinfo，补 tzdata 让 ENV TZ=Asia/Shanghai 生效
    # （否则 glibc 退回 compose 挂载的宿主机 /etc/localtime，多为 UTC → 时间差 8h）。
    tzdata \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 升级pip
RUN python -m pip install --upgrade pip setuptools wheel

# 先安装PyTorch（CPU版本）
RUN pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu

# 复制依赖文件
COPY requirements.txt .
COPY requirements.ocr.txt .

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir paddlepaddle==3.0.0 \
      -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && pip install --no-cache-dir -r requirements.ocr.txt

# 复制应用代码
COPY app/ /app/app/
COPY scripts/ /app/scripts/
COPY docs/openapi.yaml docs/openapi_usage.md /app/docs/
COPY env.example /app/.env.example

# 创建必要的数据目录
RUN mkdir -p /data/db \
    /data/frames \
    /data/videos \
    /data/models \
    /data/snapshots \
    /data/logs \
    /data/user_scripts

RUN chmod +x /app/app/entrypoint.sh

# 设置数据卷
VOLUME ["/data"]

# 暴露端口（如果有Web服务）
EXPOSE 5000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import sys; sys.exit(0)" || exit 1

WORKDIR /app/app

ENV TZ=Asia/Shanghai
# 装了 tzdata 后 TZ=Asia/Shanghai 即生效；再软链 /etc/localtime 作双保险
# （运行时会被 compose 只读挂载的宿主机 /etc/localtime 覆盖，但不影响 TZ 解析）。
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
ENV PYTHONPATH="/app:$PYTHONPATH"

# 设置入口点
ENTRYPOINT ["./entrypoint.sh"]

# 标签信息
LABEL maintainer="Video BA Pipe Team" \
      version="${APP_VERSION}" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.created="${BUILD_TIME}" \
      description="Video Behavior Analysis Pipeline - CPU Version" \
      gpu.enabled="false"
